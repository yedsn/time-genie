{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "时序",
    "version":  "0.2.0",
    "identifier":  "com.timegenie.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:5297",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "macOSPrivateApi":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "时序",
                                    "url":  "/?view=main",
                                    "width":  1160,
                                    "height":  760,
                                    "minWidth":  920,
                                    "minHeight":  620,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "center":  true,
                                    "visible":  true
                                },
                                {
                                    "label":  "hover",
                                    "title":  "今日计时",
                                    "url":  "/?view=hover",
                                    "width":  380,
                                    "height":  300,
                                    "resizable":  false,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "shadow":  false,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NUY3Q0UxNkI4RDAwQTgKUldTb0FJMXI0WHhmNmRNcSsvQzduRFhVVFJMdmtGRExWM29MSVhpOTd3RDd4MUhmN2JHRUMyeGwK",
                                    "endpoints":  [
                                                      "https://gitee.com/hongxiaojian/time-genie/releases/download/latest/latest.json",
                                                      "https://github.com/yedsn/time-genie/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}
